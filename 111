// --- 核心逻辑：监听定时任务和HTTP请求 ---
addEventListener('scheduled', event => {
  event.waitUntil(handleSchedule(event.scheduledTime));
});

addEventListener('fetch', event => {
  event.respondWith(handleRequest(event.request));
});

/**
 * HTTP请求路由器
 */
async function handleRequest(request) {
  const url = new URL(request.url);

  if (request.method === 'GET' && url.pathname === '/') {
    return new Response(getHtmlPage(), {
      headers: { 'Content-Type': 'text/html; charset=utf-8' },
    });
  }

  // --- 需要密码验证的API ---
  if (request.method === 'POST') {
    const formData = await request.formData();
    const password = formData.get('password');

    if (password !== ADMIN_PASSWORD) {
      return new Response(JSON.stringify({ success: false, message: '密码错误！' }), {
        status: 403,
        headers: { 'Content-Type': 'application/json' },
      });
    }

    // 密码正确，路由到具体处理函数
    if (url.pathname === '/update') {
      return await handleManualUpdate();
    }
    if (url.pathname === '/get-urls') {
      return await handleGetUrls();
    }
    if (url.pathname === '/set-urls') {
      const newUrls = formData.get('urls');
      return await handleSetUrls(newUrls);
    }
  }

  return new Response('Not Found', { status: 404 });
}

/**
 * 处理手动更新请求
 */
async function handleManualUpdate() {
  try {
    const result = await performUpdate();
    return new Response(JSON.stringify(result), {
      status: 200,
      headers: { 'Content-Type': 'application/json' },
    });
  } catch (error) {
    console.error("Manual update failed:", error);
    return new Response(JSON.stringify({ success: false, message: `更新失败: ${error.message}` }), {
      status: 500,
      headers: { 'Content-Type': 'application/json' },
    });
  }
}

/**
 * 从KV获取订阅链接
 */
async function handleGetUrls() {
  try {
    const urls = await CONFIG_KV.get('subscription_urls');
    return new Response(JSON.stringify({ success: true, urls: urls || '' }), {
      status: 200,
      headers: { 'Content-Type': 'application/json' },
    });
  } catch (error) {
    return new Response(JSON.stringify({ success: false, message: `获取链接失败: ${error.message}` }), {
      status: 500,
    });
  }
}

/**
 * 向KV写入订阅链接
 */
async function handleSetUrls(newUrls) {
  try {
    await CONFIG_KV.put('subscription_urls', newUrls);
    return new Response(JSON.stringify({ success: true, message: '订阅链接已成功保存！' }), {
      status: 200,
      headers: { 'Content-Type': 'application/json' },
    });
  } catch (error) {
    return new Response(JSON.stringify({ success: false, message: `保存链接失败: ${error.message}` }), {
      status: 500,
    });
  }
}

/**
 * 定时任务处理函数
 */
async function handleSchedule(scheduledTime) {
  console.log(`Scheduled trigger at: ${new Date(scheduledTime).toISOString()}`);
  await performUpdate();
}

/**
 * 核心更新逻辑（从KV读取链接）
 */
async function performUpdate() {
  console.log("Starting update process...");
  
  // 从KV读取订阅链接
  const subscriptionUrlsString = await CONFIG_KV.get('subscription_urls');
  if (!subscriptionUrlsString) {
    const message = "Error: No subscription URLs found in KV. Please set them via the web interface.";
    console.error(message);
    return { success: false, message };
  }
  const subscriptionUrls = subscriptionUrlsString.trim().split('\n');

  const uniqueNodes = {};
  for (const url of subscriptionUrls) {
    if (!url) continue;
    console.log(`Processing URL: ${url.substring(0, 50)}...`);
    try {
      const subResponse = await fetch(url);
      if (!subResponse.ok) {
        console.warn(`Failed to fetch from ${url}: ${subResponse.status} ${subResponse.statusText}`);
        continue;
      }
      const base64Content = await subResponse.text();
      const decodedContent = atob(base64Content);
      const nodeLines = decodedContent.trim().split('\n');

      for (const line of nodeLines) {
        const node = parseNode(line);
        if (node && !uniqueNodes[node.ip]) {
          uniqueNodes[node.ip] = `${node.ip}:${node.port}#${node.remark}`;
        }
      }
    } catch (error) {
      console.error(`An error occurred while processing URL ${url}:`, error);
    }
  }

  if (Object.keys(uniqueNodes).length === 0) {
    const message = "No valid nodes found from any URL to update.";
    console.log(message);
    return { success: false, message };
  }

  const finalContent = Object.values(uniqueNodes).sort().join('\n');
  console.log(`Total unique nodes extracted (by IP): ${Object.keys(uniqueNodes).length}`);

  try {
    await updateGithubFile(finalContent);
    console.log("Successfully updated GitHub file.");
    return { success: true, message: `更新成功！共找到 ${Object.keys(uniqueNodes).length} 个独立IP。`, count: Object.keys(uniqueNodes).length };
  } catch (error) {
    console.error("GitHub update failed:", error);
    return { success: false, message: `GitHub更新失败: ${error.message}` };
  }
}

