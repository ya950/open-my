// ==================== 工具函数 ====================
const Utils = {
  flattenServices() {
    const result = {};
    Object.values(CONFIG.services).forEach(category => Object.assign(result, category));
    return result;
  },
  
  getEnabledServices() {
    const flatServices = this.flattenServices();
    return Object.keys(flatServices).filter(service => flatServices[service]);
  },
  
  getCountryNodeNames() {
    return CONFIG.countries.map(c => `${c.name}节点`);
  },

  // 前置节点提取逻辑
  getTransitProxies(config) {
    const proxies = config?.proxies || [];
    
    // 1. 强力过滤：踢掉机场面板的假节点（信息提示类）
    const validProxies = proxies.filter(p => !/官网|套餐|流量|异常|剩余|过期|到期/i.test(p.name));
    
    // 2. 协议过滤：排除掉不适合做前置的协议
    const excludedTypes = ["ss", "socks5", "socks", "http"];
    
    // 3. 放行所有合法协议的节点（VLESS, VMess, Trojan, Hysteria 等自由选择）
    return validProxies
      .filter(p => !excludedTypes.includes(p.type))
      .map(p => p.name);
  }
};

// ==================== 配置生成器 ====================
const ConfigGenerator = {
  initDnsConfig() {
    const dnsConfig = { ...CONFIG.dns.config };
    dnsConfig.nameserver = [...CONFIG.dns.foreign];
    dnsConfig["proxy-server-nameserver"] = [...CONFIG.dns.domestic];
    dnsConfig["direct-nameserver"] = [...CONFIG.dns.domestic];
    dnsConfig["nameserver-policy"]["geosite:private,cn"] = [...CONFIG.dns.domestic];
    return dnsConfig;
  },
  
  generateRuleProviders() {
    const providers = {};
    const common = CONFIG.ruleProviderCommon;
    Object.keys(CONFIG.ruleProviders).forEach(key => {
      providers[key] = { ...common, ...CONFIG.ruleProviders[key] };
    });
    return providers;
  },
  
  generateRules() {
    const enabledServices = Utils.getEnabledServices();
    const rules = [];

    // 【第六条优化】：剔除硬编码冗余，极致缩减生成负担
    // 基础直连与分流策略
    rules.push("DOMAIN-SUFFIX,github.io,节点选择", "DOMAIN,v2rayse.com,节点选择");
    
    // 细分规则：按需加载 Provider
    if (enabledServices.includes("苹果服务")) rules.push("RULE-SET,apple,苹果服务");
    if (enabledServices.includes("YouTube")) rules.push("RULE-SET,YouTube,YouTube");
    if (enabledServices.includes("Netflix")) rules.push("RULE-SET,Netflix,Netflix");
    if (enabledServices.includes("Spotify")) rules.push("RULE-SET,Spotify,Spotify");
    if (enabledServices.includes("AI")) rules.push("RULE-SET,AI,AI");
    if (enabledServices.includes("TikTok")) rules.push("RULE-SET,TikTok,TikTok");
    
    // 谷歌规则依托强大的 Provider，一刀砍去那十几条多余的 DOMAIN 匹配
    if (enabledServices.includes("谷歌服务")) rules.push("RULE-SET,google,谷歌服务");
    
    // Loyalsoldier 全局规则及基础环境策略
    rules.push(
      "RULE-SET,applications,全局直连", "RULE-SET,private,全局直连", "RULE-SET,reject,广告过滤",
      "RULE-SET,icloud,微软服务", "RULE-SET,proxy,节点选择", "RULE-SET,gfw,节点选择",
      "RULE-SET,tld-not-cn,节点选择", "RULE-SET,direct,全局直连",
      "RULE-SET,lancidr,全局直连,no-resolve", "RULE-SET,cncidr,全局直连,no-resolve"
    );
    
    if (enabledServices.includes("电报消息")) rules.push("RULE-SET,telegramcidr,电报消息,no-resolve");
    
    rules.push("GEOSITE,CN,全局直连", "GEOIP,LAN,全局直连,no-resolve", "GEOIP,CN,全局直连,no-resolve", "MATCH,漏网之鱼");
    
    return rules;
  },
  
  generateProxyGroups(config) {
    const groups = [];
    const enabledServices = Utils.getEnabledServices();
    const countryNodeNames = Utils.getCountryNodeNames();
    
    // 过滤掉不可用的面板提示节点
    const validProxies = config?.proxies?.filter(p => !/官网|套餐|流量|异常|剩余|过期|到期/i.test(p.name)).map(p => p.name) || [];
    const transitProxies = Utils.getTransitProxies(config);

    // 1. 核心前置自动测速池
    groups.push({
      ...CONFIG.groupBaseOption,
      name: "自动前置",
      type: "url-test",
      interval: 120,
      tolerance: 50,
      proxies: transitProxies,
      icon: "https://cdn.jsdelivr.net/gh/hfg-gmuend/openmoji@13.1.0/color/svg/1F680.svg"
    });

    // 2. 手动干预开关：让你随时接管第一跳的控制权
    groups.push({
      ...CONFIG.groupBaseOption,
      name: "前置选择",
      type: "select",
      proxies: ["自动前置", ...transitProxies], 
      icon: "https://cdn.jsdelivr.net/gh/hfg-gmuend/openmoji@13.1.0/color/svg/1F511.svg"
    });
    
    // 3. 主干策略组
    groups.push(
      {
        ...CONFIG.groupBaseOption,
        name: "节点选择",
        type: "select",
        proxies: [
          "前置选择", 
          "自动选择",
          "故障转移",
          "负载均衡",
          ...countryNodeNames,
          ...validProxies
        ],
        icon: "https://cdn.jsdelivr.net/gh/hfg-gmuend/openmoji@13.1.0/color/svg/1F3AF.svg"
      },
      {
        ...CONFIG.groupBaseOption,
        name: "自动选择",
        type: "url-test",
        interval: 120,
        tolerance: 200,
        "include-all": true,
        filter: "^(?!.*(官网|套餐|流量|异常|剩余|过期|到期)).*$",
        icon: "https://cdn.jsdelivr.net/gh/hfg-gmuend/openmoji@13.1.0/color/svg/1F680.svg"
      },
      {
        ...CONFIG.groupBaseOption,
        name: "故障转移",
        type: "fallback",
        "include-all": true,
        filter: "^(?!.*(官网|套餐|流量|异常|剩余|过期|到期)).*$",
        icon: "https://cdn.jsdelivr.net/gh/hfg-gmuend/openmoji@13.1.0/color/svg/1F504.svg"
      }
    );
    
    if (CONFIG.features.loadBalance) {
      groups.push({
        ...CONFIG.groupBaseOption,
        name: "负载均衡",
        type: "load-balance",
        strategy: "consistent-hashing", 
        url: "https://www.google.com/generate_204",
        interval: 300,
        "include-all": true,
        filter: "^(?!.*(官网|套餐|流量|异常|剩余|过期|到期)).*$",
        icon: "https://cdn.jsdelivr.net/gh/hfg-gmuend/openmoji@13.1.0/color/svg/2696.svg"
      });
    }

    // 4. 服务分流菜单
    const getCleanServiceProxies = () => [
      "节点选择",
      "自动选择",
      "故障转移",
      "负载均衡",
      ...countryNodeNames,
      "全局直连"
    ];
    
    const serviceConfigs = [
      { key: "谷歌服务", icon: "Google.png" },
      { key: "YouTube", icon: "YouTube.png" },
      { key: "Netflix", icon: "Netflix.png" },
      { key: "电报消息", icon: "Telegram.png" },
      { key: "苹果服务", icon: "Apple.png" },
      { key: "Spotify", icon: "Spotify.png" }
    ];

    serviceConfigs.forEach(svc => {
      if (enabledServices.includes(svc.key)) {
        groups.push({
          ...CONFIG.groupBaseOption,
          name: svc.key,
          type: "select",
          proxies: getCleanServiceProxies(),
          icon: `https://cdn.jsdelivr.net/gh/Koolson/Qure@master/IconSet/Color/${svc.icon}`
        });
      }
    });

    if (enabledServices.includes("AI")) {
      groups.push({
        ...CONFIG.groupBaseOption, name: "AI", type: "select",
        proxies: getCleanServiceProxies().filter(p => p !== "全局直连"),
        icon: "https://cdn.jsdelivr.net/gh/hfg-gmuend/openmoji@13.1.0/color/svg/1F916.svg"
      });
    }
    
    if (enabledServices.includes("TikTok")) {
      groups.push({
        ...CONFIG.groupBaseOption, name: "TikTok", type: "select",
        proxies: getCleanServiceProxies().filter(p => p !== "全局直连"),
        icon: "https://cdn.jsdelivr.net/gh/Koolson/Qure@master/IconSet/Color/TikTok.png"
      });
    }
    
    if (enabledServices.includes("微软服务")) {
      groups.push({
        ...CONFIG.groupBaseOption, name: "微软服务", type: "select",
        proxies: ["全局直连", ...countryNodeNames.slice(0, 4), "节点选择", "自动选择", "故障转移"],
        icon: "https://cdn.jsdelivr.net/gh/Koolson/Qure@master/IconSet/Color/Microsoft.png"
      });
    }
    
    if (CONFIG.features.countryGroups) {
      CONFIG.countries.forEach(country => {
        groups.push({
          ...CONFIG.groupBaseOption,
          name: `${country.name}节点`,
          type: "fallback",
          interval: 300,
          tolerance: 0,
          "include-all": true,
          filter: country.filter,
          icon: country.icon
        });
      });
    }
    
    if (CONFIG.features.adBlock) {
      groups.push({
        ...CONFIG.groupBaseOption, name: "广告过滤", type: "select", proxies: ["REJECT", "DIRECT"],
        icon: "https://cdn.jsdelivr.net/gh/Koolson/Qure@master/IconSet/Color/Advertising.png"
      });
    }
    
    groups.push(
      {
        ...CONFIG.groupBaseOption, name: "全局直连", type: "select", proxies: ["DIRECT", "节点选择", "自动选择", "故障转移"],
        icon: "https://cdn.jsdelivr.net/gh/Koolson/Qure@master/IconSet/Color/Direct.png"
      },
      {
        ...CONFIG.groupBaseOption, name: "全局拦截", type: "select", proxies: ["REJECT", "DIRECT"],
        icon: "https://cdn.jsdelivr.net/gh/Koolson/Qure@master/IconSet/Color/Reject.png"
      },
      {
        ...CONFIG.groupBaseOption, name: "漏网之鱼", type: "select", 
        proxies: ["节点选择", "自动选择", "故障转移", "负载均衡", "全局直连"],
        icon: "https://cdn.jsdelivr.net/gh/Koolson/Qure@master/IconSet/Color/Final.png"
      }
    );
    
    return groups;
  }
};

// ==================== 主函数 ====================
function main(config) {
  const proxyCount = config?.proxies?.length ?? 0;
  const proxyProviderCount = typeof config?.["proxy-providers"] === "object" ? Object.keys(config["proxy-providers"]).length : 0;
  
  if (proxyCount === 0 && proxyProviderCount === 0) {
    throw new Error("配置文件中未找到任何代理");
  }
  
  config["dns"] = ConfigGenerator.initDnsConfig();
  config["rule-providers"] = ConfigGenerator.generateRuleProviders();
  config["rules"] = ConfigGenerator.generateRules();
  config["proxy-groups"] = ConfigGenerator.generateProxyGroups(config);
  
  if(config["proxies"]) {
    config["proxies"].forEach(proxy => {
      proxy.udp = true;
      // 为 SS 节点注入 dialer-proxy，保留你的强制拨号要求（未添加防套娃优化）
      if (CONFIG.features.chainProxy && proxy.type === "ss") {
        proxy["dialer-proxy"] = "前置选择"; 
      }
    });
  }
  
  return config;
}
