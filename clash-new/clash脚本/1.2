const Utils = {
  getEnabledServices() {
    const flat = Object.assign({}, ...Object.values(CONFIG.services));
    return Object.keys(flat).filter(s => flat[s]);
  },
  getCountryNodeNames() { return CONFIG.countries.map(c => `${c.name}节点`); },
  getTransitProxies(config) {
    const proxies = config?.proxies || [];
    const valid = proxies.filter(p => !/官网|套餐|流量|异常|剩余|过期|到期/i.test(p.name));
    return valid.filter(p => !["ss", "socks5", "socks", "http"].includes(p.type)).map(p => p.name);
  }
};

const ConfigGenerator = {
  generateRules() {
    const enabled = Utils.getEnabledServices();
    const rules = ["DOMAIN-KEYWORD,stun,节点选择"]; // WebRTC 防漏
    if (enabled.includes("谷歌服务")) rules.push("PROCESS-NAME,com.google.android.gm,谷歌服务");
    if (enabled.includes("TikTok")) rules.push("DOMAIN-SUFFIX,tiktokv.us,TikTok");
    if (enabled.includes("AI")) rules.push("DOMAIN-SUFFIX,gemini.google.com,AI");
    
    rules.push("DOMAIN-SUFFIX,github.io,节点选择", "DOMAIN,v2rayse.com,节点选择");
    if (enabled.includes("苹果服务")) rules.push("RULE-SET,apple,苹果服务");
    if (enabled.includes("YouTube")) rules.push("RULE-SET,YouTube,YouTube");
    if (enabled.includes("Netflix")) rules.push("RULE-SET,Netflix,Netflix");
    if (enabled.includes("Spotify")) rules.push("RULE-SET,Spotify,Spotify");
    if (enabled.includes("AI")) rules.push("RULE-SET,AI,AI");
    if (enabled.includes("TikTok")) rules.push("RULE-SET,TikTok,TikTok");
    if (enabled.includes("谷歌服务")) rules.push("RULE-SET,google,谷歌服务");
    
    rules.push("RULE-SET,applications,全局直连", "RULE-SET,private,全局直连", "RULE-SET,reject,广告过滤", "RULE-SET,icloud,微软服务", "RULE-SET,proxy,节点选择", "RULE-SET,gfw,节点选择", "RULE-SET,tld-not-cn,节点选择", "RULE-SET,direct,全局直连", "RULE-SET,lancidr,全局直连,no-resolve", "RULE-SET,cncidr,全局直连,no-resolve");
    if (enabled.includes("电报消息")) rules.push("RULE-SET,telegramcidr,电报消息,no-resolve");
    rules.push("GEOSITE,CN,全局直连", "GEOIP,LAN,全局直连,no-resolve", "GEOIP,CN,全局直连,no-resolve", "MATCH,漏网之鱼");
    return rules;
  },
  
  generateProxyGroups(config) {
    const groups = [];
    const countryNodeNames = Utils.getCountryNodeNames();
    const validProxies = config?.proxies?.filter(p => !/官网|套餐|流量|异常|剩余|过期|到期/i.test(p.name)).map(p => p.name) || [];
    const transit = Utils.getTransitProxies(config);

    groups.push({ ...CONFIG.groupBaseOption, name: "自动前置", type: "url-test", proxies: transit });
    groups.push({ ...CONFIG.groupBaseOption, name: "前置选择", type: "select", proxies: ["自动前置", ...transit] });
    groups.push({ ...CONFIG.groupBaseOption, name: "节点选择", type: "select", proxies: ["前置选择", "自动选择", "故障转移", ...countryNodeNames, ...validProxies] });
    groups.push({ ...CONFIG.groupBaseOption, name: "自动选择", type: "url-test", "include-all": true });
    groups.push({ ...CONFIG.groupBaseOption, name: "故障转移", type: "fallback", "include-all": true });
    
    return groups;
  }
};

function main(config) {
  config["dns"] = { ...CONFIG.dns.config, nameserver: CONFIG.dns.foreign, "proxy-server-nameserver": CONFIG.dns.domestic };
  config["rule-providers"] = Object.fromEntries(Object.entries(CONFIG.ruleProviders).map(([k, v]) => [k, { ...CONFIG.ruleProviderCommon, ...v }]));
  config["rules"] = ConfigGenerator.generateRules();
  config["proxy-groups"] = ConfigGenerator.generateProxyGroups(config);
  
  config.proxies?.forEach(p => {
    p.udp = true;
    if (CONFIG.features.chainProxy && p.type === "ss" && !/优化|固定IP|中转|专线/i.test(p.name)) {
      p["dialer-proxy"] = "前置选择"; 
    }
  });
  return config;
}
