};

// ==================== 主函数 ====================
function main(config) {
  const proxyCount = config?.proxies?.length ?? 0;
  const proxyProviderCount = typeof config?.["proxy-providers"] === "object" ? Object.keys(config["proxy-providers"]).length : 0;
  
  if (proxyCount === 0 && proxyProviderCount === 0) {
    throw new Error("配置文件中未找到任何代理");
  }
  
  config["dns"] = ConfigGenerator.initDnsConfig();
  
  config["sniffer"] = {
    enable: true,
    "force-dns-mapping": true,
    "parse-pure-ip": true,
    sniff: {
      HTTP: { ports: [80, 8080, 8880] },
      TLS: { ports: [443, 8443] },
      QUIC: { ports: [443, 8443] }
    },
    "skip-domains": ["+.push.apple.com", "Mijia Cloud"] // 修复新版 Mihomo 字段名警告
  };
  
  config["rule-providers"] = ConfigGenerator.generateRuleProviders();
  config["rules"] = ConfigGenerator.generateRules();
  config["proxy-groups"] = ConfigGenerator.generateProxyGroups(config);
  
  // 动态注入 dialer-proxy
  if(config["proxies"]) {
    // 获取前置节点列表，用于判断是否真的能激活链式代理
    const transitProxies = Utils.getTransitProxies(config);
    const isChainProxyActive = CONFIG.features.chainProxy && transitProxies.length > 0;

    config["proxies"].forEach(proxy => {
      proxy.udp = true;
      // 只有当前置组真正存在时，才注入 dialer-proxy，防止生成了指向不存在组的死链
      if (isChainProxyActive && CONFIG.features.chainProxyTypes.includes(proxy.type)) {
        proxy["dialer-proxy"] = "前置选择"; 
      }
    });
    
    // 如果用户开启了 chainProxy 但节点全是不支持前置的协议，给出友好提示
    if (CONFIG.features.chainProxy && !isChainProxyActive) {
      console.log("提示: 开启了 chainProxy，但当前订阅没有可用的前置节点(或全是落地协议)，已自动降级为普通模式。");
    }
  }
  
  return config;
}
