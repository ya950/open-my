    const enabledServices = Utils.getEnabledServices();
    
    const validProxies = Utils.getValidProxies(config);
    const transitProxies = Utils.getTransitProxies(config);

    // 已移除故障转移和负载均衡
    const mainSelectProxies = ["前置选择", "自动选择"];
    const finalProxies = ["节点选择", "自动选择", "全局直连"];

    // 1. 核心前置自动测速池
    groups.push({
      ...CONFIG.groupBaseOption,
