      type: "url-test",
      tolerance: 100,
      concurrent: 10,
      proxies: transitProxies,
      icon: "https://s1.aigei.com/src/img/png/0d/0d449214de1742cd9683d395bb4ad511.png?imageMogr2/auto-orient/thumbnail/!282x282r/gravity/Center/crop/282x282/quality/85/%7CimageView2/2/w/282&e=2051020800&token=P7S2Xpzfz11vAkASLTkfHN7Fw-oOZBecqeJaxypL:zIpxbGdu32VTmGpH4niIECEabyU="
    });

    // 2. 手动干预开关
