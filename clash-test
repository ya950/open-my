// ==================== 规则集生成函数 ====================
// 创建规则集的函数，支持多个源
function createRuleSet(service, sources, type = "list") {
  if (typeof sources === "string") {
    sources = [sources];
  }
  
  const result = {};
  sources.forEach(source => {
    const key = source === "blackmatrix7" ? `${service}` : `${service}`;
    result[key] = {
      ...ruleProviderCommon,
      "behavior": "classical",
      "url": `${ruleSources[source]}/${service}/${service}.${type}`,
      "path": `${basePath[source]}/${service}.yaml`
    };
  });
  
  return result;
}

