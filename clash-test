// ==================== 规则集生成函数 ====================
// 创建规则集的函数，避免重复代码
function createRuleSet(service, source, type = "list") {
  return {
    ...ruleProviderCommon,
    "behavior": "classical",
    "url": `${ruleSources[source]}/${service}/${service}.${type}`,
    "path": `${basePath[source]}/${service}.yaml`
  };
}

