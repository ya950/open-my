      interval: 300,
      tolerance: 50,
      proxies: chainProxyNames.length > 0 ? chainProxyNames : allProxies,
      icon: "https://s1.aigei.com/prevfiles/16a8d432d62d410bb7515eaab449adff.png?e=2051020800&token=P7S2Xpzfz11vAkASLTkfHN7Fw-oOZBecqeJaxypL:iAOdmSMF2lupg5mJthM-6oScsPA="
    });
    
    // 节点选择组
    groups.push({
      ...CONFIG.groupBaseOption,
      name: "节点选择",
      type: "select",
      proxies: ["自动选择", "负载均衡", "故障转移", ...countryNodeNames, ...allProxies],
