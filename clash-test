// ==================== 代理组生成函数 ====================
/**
 * 创建服务专用代理组
 * @param {Object} service - 服务配置对象 { name, icon }
 * @param {Array} defaultProxies - 默认的代理策略数组
 * @param {Array} allChainProxyNames - 所有链式代理组名称
 * @param {Array} allCountryNodeNames - 所有国家节点组名称
 * @returns {Object} 代理组配置对象
 */
function createServiceGroup(service, defaultProxies, allChainProxyNames, allCountryNodeNames) {
  // 检查是否有特殊策略且特殊策略开关开启
  const specialStrategy = featureSwitches.specialStrategy 
    ? serviceSpecialStrategies[service.name] 
    : null;
  
  // 如果有特殊策略，使用特殊策略；否则使用默认策略
  const finalProxies = specialStrategy 
    ? specialStrategy.proxies 
    : defaultProxies;

  return {
    ...groupBaseOption,
    "name": service.name,
    "type": "select",
    "proxies": finalProxies,
    "icon": service.icon,
    // 添加注释说明特殊策略原因（如果有）
    ...(specialStrategy && { "remarks": specialStrategy.reason })
  };
}

// ==================== 主函数 ====================
function main(config) {
  // 检查代理是否存在
  const proxyCount = config?.proxies?.length ?? 0;
  const proxyProviderCount = typeof config?.["proxy-providers"] === "object" ? Object.keys(config["proxy-providers"]).length : 0;
  
  if (proxyCount === 0 && proxyProviderCount === 0) {
    throw new Error("配置文件中未找到任何代理");
  }

  // 覆盖DNS配置
  config["dns"] = dnsConfig;

  // 获取所有节点名称
  const allProxies = config?.proxies?.map(p => p.name) || [];
  
  // 分离SS节点和其他节点
  const ssProxies = config?.proxies?.filter(p => p.type === "ss")?.map(p => p.name) || [];
  const otherProxies = config?.proxies?.filter(p => p.type !== "ss")?.map(p => p.name) || [];
  
  // 【修复】创建链式代理组 - 总是创建，但根据条件调整内容
  const chainProxyGroups = [];
  const chainProxyNames = [];
  
  if (featureSwitches.chainProxy && ssProxies.length > 0) {
    ssProxies.forEach(ssProxy => {
      const chainGroupName = `落地-${ssProxy}`;
      chainProxyGroups.push({
        ...groupBaseOption,
        "name": chainGroupName,
        "type": "relay", // 使用relay类型实现链式代理
        "proxies": ["前置代理", ssProxy], // 前置代理 -> SS节点
        "icon": "https://cdn.jsdelivr.net/gh/Koolson/Qure@master/IconSet/Color/Proxy.png",
        "hidden": true // 隐藏这些单独的链式代理组
      });
      chainProxyNames.push(chainGroupName);
    });
  }
  
  // 生成国家/地区分组
  const countryGroups = [];
  const countryNodeNames = [];
  
  if (featureSwitches.countryGroups) {
    COUNTRIES.forEach(country => {
      countryGroups.push({
        ...groupBaseOption,
        "name": `${country.name}节点`,
        "type": "fallback", // 故障转移类型
        "interval": 30,     // 30秒测一次
        "tolerance": 1,    // 连续失败1次（即30秒）就切换
        "include-all": true,
        "filter": country.filter,
        "exclude-filter": country.excludeFilter,
        "icon": country.icon
      });
      countryNodeNames.push(`${country.name}节点`);
    });
  }
  
  // 定义默认的服务代理策略，将"节点选择"放在第一位
  const defaultServiceProxies = [
    "节点选择",
    "落地代理",
    "落地选优",
    ...chainProxyNames,
    "自动选择",
    "负载均衡",
    "故障转移",
    ...countryNodeNames,
    "全局直连"
  ];

  // 【修复】配置代理组 - 总是创建基本代理组，避免"未找到"错误
  const proxyGroups = [
    // 1. 核心策略模块
    {
      ...groupBaseOption,
      "name": "自动选择",
      "type": "url-test",
      "interval": 300,
      "tolerance": 50,
      "include-all": true,
      "filter": "^(?!.*(官网|套餐|流量|异常|剩余)).*$",
      "icon": "https://s1.aigei.com/src/img/png/98/98e64229aedc48a0950f360f832f3269.png?imageMogr2/auto-orient/thumbnail/!282x282r/gravity/Center/crop/282x282/quality/85/%7CimageView2/2/w/282&e=2051020800&token=P7S2Xpzfz11vAkASLTkfHN7Fw-oOZBecqeJaxypL:x39SiWt0W0r_OCaVGN8l9j0kaJs="
    },
    {
      ...groupBaseOption,
      "name": "负载均衡",
      "type": "load-balance",
      "strategy": "consistent-hashing",
      "interval": 300,
      "include-all": true,
      "filter": "^(?!.*(官网|套餐|流量|异常|剩余)).*$",
      "icon": "https://s1.aigei.com/src/img/png/dc/dc05262cfe7440088d3a3f5323d8079a.png?imageMogr2/auto-orient/thumbnail/!282x282r/gravity/Center/crop/282x282/quality/85/%7CimageView2/2/w/282&e=2051020800&token=P7S2Xpzfz11vAkASLTkfHN7Fw-oOZBecqeJaxypL:t9h-TXk8gOSDGvuaN036WE0PbPw="
    },
    {
      ...groupBaseOption,
      "name": "故障转移",
      "type": "fallback",
      "interval": 300,
      "include-all": true,
      "filter": "^(?!.*(官网|套餐|流量|异常|剩余)).*$",
      "icon": "https://s1.aigei.com/src/img/png/31/31b3bb8f04c74735acb7e51da00a23cc.png?imageMogr2/auto-orient/thumbnail/!282x282r/gravity/Center/crop/282x282/quality/85/%7CimageView2/2/w/282&e=2051020800&token=P7S2Xpzfz11vAkASLTkfHN7Fw-oOZBecqeJaxypL:ugSCko1X49-ypn8PIUvQCADFJ5w="
    }
  ];

  // 【修复】2. 链式代理结构（总是创建，但根据条件调整内容）
  // 只有启用链式代理且有SS节点时才创建前置代理
  if (featureSwitches.chainProxy && ssProxies.length > 0) {
    proxyGroups.push({
      ...groupBaseOption,
      "name": "前置代理",
      "type": "select",
      "proxies": [
        ...countryNodeNames,
        "自动选择",
        ...otherProxies
      ],
      "icon": "https://s1.aigei.com/src/img/png/ef/ef79a8fcd6774993b31a6f8a0c411778.png?imageMogr2/auto-orient/thumbnail/!282x282r/gravity/Center/crop/282x282/quality/85/%7CimageView2/2/w/282&e=2051020800&token=P7S2Xpzfz11vAkASLTkfHN7Fw-oOZBecqeJaxypL:8ybyPgSllo5x7ySCXEs3I--GEJ0="
    });
  }

  // 【修复】落地代理（总是创建）
  proxyGroups.push({
    ...groupBaseOption,
    "name": "落地代理",
    "type": "select",
    "proxies": featureSwitches.chainProxy && ssProxies.length > 0 ? [
      "落地选优",
      ...chainProxyNames
    ] : [
      "自动选择",
      ...allProxies
    ],
    "icon": "https://s1.chu0.com/src/img/png/68/68f56102bc574fa58d0bfa27e9832ac7.png?imageMogr2/auto-orient/thumbnail/!282x282r/gravity/Center/crop/282x282/quality/85/%7CimageView2/2/w/282&e=2051020800&token=1srnZGLKZ0Aqlz6dk7yF4SkiYf4eP-YrEOdM1sob:A6tEl-e0oPV3yubbcDl_JxI56jM="
  });

  // 【修复】落地选优（总是创建）
  proxyGroups.push({
    ...groupBaseOption,
    "name": "落地选优",
    "type": "fallback",
    "interval": 300,
    "tolerance": 50,
    "proxies": chainProxyNames.length > 0 ? chainProxyNames : allProxies,
    "icon": "https://s1.aigei.com/prevfiles/16a8d432d62d410bb7515eaab449adff.png?e=2051020800&token=P7S2Xpzfz11vAkASLTkfHN7Fw-oOZBecqeJaxypL:iAOdmSMF2lupg5mJthM-6oScsPA="
  });

  // 3. 节点选择组
  proxyGroups.push({
    ...groupBaseOption,
    "name": "节点选择",
    "type": "select",
    "proxies": [
      "自动选择",
      "负载均衡",
      "故障转移",
      ...countryNodeNames,
      ...allProxies
    ],
    "icon": "https://s1.aigei.com/prevfiles/4869110956c5419db516657a10532f96.png?e=2051020800&token=P7S2Xpzfz11vAkASLTkfHN7Fw-oOZBecqeJaxypL:EyRhAoQyB9U3A6_VGdk8YYTqL0s="
  });

  // 4. 服务专用代理组 (根据开关动态生成)
  const enabledServices = ALL_SERVICES.filter(service => serviceSwitches[service.name]);
  if (enabledServices.length > 0) {
    proxyGroups.push(
      ...enabledServices.map(service => 
        createServiceGroup(service, defaultServiceProxies, chainProxyNames, countryNodeNames)
      )
    );
  }

  // 5. 国家/地区分组（如果启用）
  if (featureSwitches.countryGroups) {
    proxyGroups.push(...countryGroups);
  }

  // 6. 特殊功能代理组
  if (featureSwitches.adBlock) {
    proxyGroups.push({
      ...groupBaseOption,
      "name": "广告过滤",
      "type": "select",
      "proxies": ["REJECT", "DIRECT"],
      "icon": "https://cdn.jsdelivr.net/gh/Koolson/Qure@master/IconSet/Color/Advertising.png"
    });
  }

  proxyGroups.push(
    {
      ...groupBaseOption,
      "name": "全局直连",
      "type": "select",
      "proxies": ["DIRECT"],
      "icon": "https://cdn.jsdelivr.net/gh/Koolson/Qure@master/IconSet/Color/Direct.png"
    },
    {
      ...groupBaseOption,
      "name": "漏网之鱼",
      "type": "select",
      "proxies": [
        "节点选择", 
        "落地代理", 
        "落地选优", 
        "自动选择",
        "负载均衡",
        "故障转移",
        "全局直连"
      ],
      "icon": "https://cdn.jsdelivr.net/gh/Koolson/Qure@master/IconSet/Color/Final.png"
    }
  );
  
  // 7. 添加链式代理组（如果启用）
  if (featureSwitches.chainProxy) {
    proxyGroups.push(...chainProxyGroups);
  }

  // 配置代理组
  config["proxy-groups"] = proxyGroups;

  // 配置规则
  config["rule-providers"] = ruleProviders;
  config["rules"] = rules;
  
  // 为每个节点设置 udp = true
  if(config["proxies"]) {
    config["proxies"].forEach(proxy => {
      proxy.udp = true
    })
  }
  
  // 返回修改后的配置
  return config;
}
