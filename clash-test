// ==================== 工具函数 ====================
const Utils = {
  // 扁平化服务开关
  flattenServices() {
    const result = {};
    Object.values(CONFIG.services).forEach(category => {
      Object.assign(result, category);
    });
    return result;
  },
  
  // 获取启用的服务
  getEnabledServices() {
    const flatServices = this.flattenServices();
    return CONFIG.serviceDefs.filter(service => flatServices[service.name]);
  },
  
  // 生成规则URL
  generateRuleUrl(service) {
    // 所有规则都使用同一个源
    return `${CONFIG.ruleSource}/${service.key}.txt`;
  },
  
  // 生成规则路径
  generateRulePath(service) {
    return `./ruleset/${service.key}.yaml`;
  },
  
  // 获取国家节点名称
  getCountryNodeNames() {
    return CONFIG.countries.map(c => `${c.name}节点`);
  },
  
  // 生成唯一的链式代理组名
  generateUniqueChainName(ssProxy, existingNames) {
    let baseName = `落地-${ssProxy}`;
    let uniqueName = baseName;
    let counter = 1;
    
    // 确保名称唯一
    while (existingNames.includes(uniqueName)) {
      uniqueName = `${baseName}-${counter}`;
      counter++;
    }
    
    return uniqueName;
  }
};

// ==================== 配置生成器 ====================
const ConfigGenerator = {
  // 生成DNS配置
  generateDnsConfig() {
    return {
      ...CONFIG.dns.config,
      nameserver: CONFIG.dns.foreign,
      "proxy-server-nameserver": CONFIG.dns.domestic,
      "direct-nameserver": CONFIG.dns.domestic,
      "nameserver-policy": {
        "geosite:private,cn": CONFIG.dns.domestic,
        // 确保谷歌相关域名使用国外DNS
        "geosite:google": CONFIG.dns.foreign
      }
    };
  },
  
  // 生成规则集配置
  generateRuleProviders() {
    const providers = {};
    const common = { type: "http", format: "text", interval: 86400 };
    
    // 基础规则集
    const baseRules = ["reject", "proxy", "direct", "private", "gfw", "tld-not-cn", "cncidr", "lancidr", "applications", "icloud"];
    baseRules.forEach(rule => {
      providers[rule] = {
        ...common,
        behavior: rule === "cncidr" || rule === "lancidr" ? "ipcidr" : "domain",
        url: `${CONFIG.ruleSource}/${rule}.txt`,
        path: `./ruleset/${rule}.yaml`
      };
    });
    
    // 服务规则集
    Utils.getEnabledServices().forEach(service => {
      providers[service.key] = {
        ...common,
        behavior: service.key === "telegramcidr" ? "ipcidr" : 
                 (service.key === "google" || service.key === "apple") ? "domain" : "classical",
        url: Utils.generateRuleUrl(service),
        path: Utils.generateRulePath(service)
      };
    });
    
    return providers;
  },
  
  // 生成规则
  generateRules() {
    const rules = [];
    const enabledServices = Utils.getEnabledServices();
    
    // 广告拦截规则
    if (CONFIG.features.adBlock) {
      rules.push("RULE-SET,reject,广告过滤");
    }
    
    // 谷歌商店相关域名规则 - 确保这些域名走谷歌服务代理组
    CONFIG.googlePlayDomains.forEach(domain => {
      rules.push(`${domain},谷歌服务`);
    });
    
    // 手动域名规则
    rules.push(
      "DOMAIN-SUFFIX,browserleaks.com,节点选择",
      "DOMAIN-SUFFIX,xn--ngstr-lra8j.com,谷歌服务",
      "DOMAIN-SUFFIX,github.io,节点选择",
      "DOMAIN,v2rayse.com,节点选择"
    );
    
    // 代理规则
    rules.push(
      "RULE-SET,proxy,节点选择",
      "RULE-SET,gfw,节点选择",
      "RULE-SET,tld-not-cn,节点选择"
    );
    
    // 服务规则
    enabledServices.forEach(service => {
      const rule = `RULE-SET,${service.key},${service.name}`;
      rules.push(service.noResolve ? `${rule},no-resolve` : rule);
    });
    
    // 直连规则
    rules.push(
      "RULE-SET,direct,全局直连",
      "RULE-SET,cncidr,全局直连,no-resolve",
      "RULE-SET,applications,全局直连",
      "RULE-SET,private,全局直连",
      "RULE-SET,lancidr,全局直连,no-resolve",
      "GEOSITE,CN,全局直连",
      "GEOIP,LAN,全局直连,no-resolve",
      "GEOIP,CN,全局直连,no-resolve",
      "MATCH,漏网之鱼"
    );
    
    return rules;
  },
  
  // 生成代理组
  generateProxyGroups(config) {
    const groups = [];
    const enabledServices = Utils.getEnabledServices();
    const countryNodeNames = Utils.getCountryNodeNames();
    
    // 获取所有节点名称
    const allProxies = config?.proxies?.map(p => p.name) || [];
    
    // 分离SS节点和其他节点
    const ssProxies = config?.proxies?.filter(p => p.type === "ss")?.map(p => p.name) || [];
    const otherProxies = config?.proxies?.filter(p => p.type !== "ss")?.map(p => p.name) || [];
    
    // 获取已存在的代理组名称，避免重复
    const existingGroupNames = [
      "自动选择", "负载均衡", "故障转移", "前置代理", 
      "落地代理", "落地选优", "节点选择", "全局直连", "漏网之鱼",
      "广告过滤", ...countryNodeNames, ...enabledServices.map(s => s.name)
    ];
    
    // 创建链式代理组
    const chainProxyNames = [];
    if (CONFIG.features.chainProxy && ssProxies.length > 0) {
      ssProxies.forEach(ssProxy => {
        // 生成唯一的链式代理组名
        const chainGroupName = Utils.generateUniqueChainName(ssProxy, existingGroupNames.concat(chainProxyNames));
        groups.push({
          ...CONFIG.groupBaseOption,
          name: chainGroupName,
          type: "relay",
          proxies: ["前置代理", ssProxy],
          icon: "https://cdn.jsdelivr.net/gh/Koolson/Qure@master/IconSet/Color/Proxy.png",
          hidden: true
        });
        chainProxyNames.push(chainGroupName);
      });
    }
    
    // 核心策略模块
    groups.push(
      {
        ...CONFIG.groupBaseOption,
        name: "自动选择",
        type: "url-test",
        interval: 300,
        tolerance: 50,
        "include-all": true,
        filter: "^(?!.*(官网|套餐|流量|异常|剩余)).*$",
        icon: "https://s1.aigei.com/src/img/png/98/98e64229aedc48a0950f360f832f3269.png?imageMogr2/auto-orient/thumbnail/!282x282r/gravity/Center/crop/282x282/quality/85/%7CimageView2/2/w/282&e=2051020800&token=P7S2Xpzfz11vAkASLTkfHN7Fw-oOZBecqeJaxypL:x39SiWt0W0r_OCaVGN8l9j0kaJs="
      },
      {
        ...CONFIG.groupBaseOption,
        name: "负载均衡",
        type: "load-balance",
        strategy: "consistent-hashing",
        interval: 300,
        "include-all": true,
        filter: "^(?!.*(官网|套餐|流量|异常|剩余)).*$",
        icon: "https://s1.aigei.com/src/img/png/dc/dc05262cfe7440088d3a3f5323d8079a.png?imageMogr2/auto-orient/thumbnail/!282x282r/gravity/Center/crop/282x282/quality/85/%7CimageView2/2/w/282&e=2051020800&token=P7S2Xpzfz11vAkASLTkfHN7Fw-oOZBecqeJaxypL:t9h-TXk8gOSDGvuaN036WE0PbPw="
      },
      {
        ...CONFIG.groupBaseOption,
        name: "故障转移",
        type: "fallback",
        interval: 300,
        "include-all": true,
        filter: "^(?!.*(官网|套餐|流量|异常|剩余)).*$",
        icon: "https://s1.aigei.com/src/img/png/31/31b3bb8f04c74735acb7e51da00a23cc.png?imageMogr2/auto-orient/thumbnail/!282x282r/gravity/Center/crop/282x282/quality/85/%7CimageView2/2/w/282&e=2051020800&token=P7S2Xpzfz11vAkASLTkfHN7Fw-oOZBecqeJaxypL:ugSCko1X49-ypn8PIUvQCADFJ5w="
      }
    );
    
    // 链式代理结构
    if (CONFIG.features.chainProxy && ssProxies.length > 0) {
      groups.push({
        ...CONFIG.groupBaseOption,
        name: "前置代理",
        type: "select",
        proxies: [...countryNodeNames, "自动选择", ...otherProxies],
        icon: "https://s1.aigei.com/src/img/png/ef/ef79a8fcd6774993b31a6f8a0c411778.png?imageMogr2/auto-orient/thumbnail/!282x282r/gravity/Center/crop/282x282/quality/85/%7CimageView2/2/w/282&e=2051020800&token=P7S2Xpzfz11vAkASLTkfHN7Fw-oOZBecqeJaxypL:8ybyPgSllo5x7ySCXEs3I--GEJ0="
      });
    }
    
    // 落地代理
    groups.push({
      ...CONFIG.groupBaseOption,
      name: "落地代理",
      type: "select",
      proxies: CONFIG.features.chainProxy && ssProxies.length > 0 ? 
               ["落地选优", ...chainProxyNames] : 
               ["自动选择", ...allProxies],
      icon: "https://s1.chu0.com/src/img/png/68/68f56102bc574fa58d0bfa27e9832ac7.png?imageMogr2/auto-orient/thumbnail/!282x282r/gravity/Center/crop/282x282/quality/85/%7CimageView2/2/w/282&e=2051020800&token=1srnZGLKZ0Aqlz6dk7yF4SkiYf4eP-YrEOdM1sob:A6tEl-e0oPV3yubbcDl_JxI56jM="
    });
    
    // 落地选优
    groups.push({
