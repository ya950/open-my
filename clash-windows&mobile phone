// 程序入口
function main(config) {
  const proxyCount = config?.proxies?.length ?? 0;
  const proxyProviderCount =
    typeof config?.["proxy-providers"] === "object" ? Object.keys(config["proxy-providers"]).length : 0;
  if (proxyCount === 0 && proxyProviderCount === 0) {
    throw new Error("配置文件中未找到任何代理");
  }

  // 覆盖原配置中DNS配置
  config["dns"] = dnsConfig;

  // 添加连接池配置 - 移动端优化
  config["connection-pool"] = {
    "enable": true,
    "max-host-connections": 8, // 从16减少到8
    "max-connections": 512, // 从1024减少到512
    "min-idle-connections": 4, // 从8减少到4
    "max-idle-connections": 16, // 从32减少到16
    "idle-timeout": 60 // 从90减少到60秒
  };
  
  // 添加TCP配置优化
  config["tcp-concurrent"] = true;
  config["unified-delay"] = true;
  config["global-client-fingerprint"] = "chrome";
  
  // 添加移动端特定优化
  config["profile-store-selected"] = true; // 减少配置重载
  config["geodata-mode"] = true; // 使用内存中的地理数据，减少磁盘IO
  config["geodata-loader"] = "memconservative"; // 保守的内存加载模式
  
  config["experimental"] = {
    "ignore-resolve-fail": true, // 忽略解析失败，减少重试
    "sniff-tls-sni": true, // 启用SNI嗅探，提高连接效率
    "tcp-fast-open": true, // 启用TCP快速打开
    "tcp-multiplexing": { // 启用TCP连接复用
      "enable": true,
      "max-connections": 4,
      "min-connections": 1,
      "idle-timeout": 60,
      "enable-conn-reuse": true
    }
  };

  // 获取所有节点名称
  const allProxies = config?.proxies?.map(p => p.name) || [];
  
  // 分离不同类型的节点
  const ssProxies = config?.proxies?.filter(p => p.type === "ss")?.map(p => p.name) || [];
  const socks5Proxies = config?.proxies?.filter(p => p.type === "socks5")?.map(p => p.name) || [];
  const httpProxies = config?.proxies?.filter(p => p.type === "http")?.map(p => p.name) || [];
  const otherProxies = config?.proxies?.filter(p => !["ss", "socks5", "http"].includes(p.type))?.map(p => p.name) || [];
  
  // 合并所有可用于链式代理的节点类型
  const chainableProxies = [...ssProxies, ...socks5Proxies, ...httpProxies];
  
  // 创建链式代理组 - 为每个可用节点创建一个链式代理组
  const chainProxyGroups = [];
  chainableProxies.forEach(proxy => {
    const chainGroupName = `落地-${proxy}`;
    chainProxyGroups.push({
      ...groupBaseOption,
      "name": chainGroupName,
      "type": "relay", // 使用relay类型实现链式代理
      "proxies": ["前置代理", proxy], // 前置代理 -> 节点
      "icon": "https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Proxy.png",
      "hidden": true // 隐藏这些单独的链式代理组
    });
  });
  
  // 获取所有链式代理组名称
  const chainProxyNames = chainableProxies.map(proxy => `落地-${proxy}`);
  
  // 确保链式代理组不为空，如果为空则使用其他节点作为备选
  const autoSelectProxies = chainProxyNames.length > 0 ? chainProxyNames : allProxies.slice(0, 5);
  
  // 获取所有国家分组名称
  const countryGroups = [
    "日本手动", "美国手动", "台湾手动", "香港手动", "狮城手动", "韩国手动"
  ];
  
  // 获取所有国家自动选择分组名称
  const countryAutoGroups = countryGroups.map(country => country.replace("手动", "自动"));
  
  // 获取所有国家故障转移分组名称
  const countryFailoverGroups = countryGroups.map(country => country.replace("手动", "故转"));
  
  // 覆盖原配置中的代理组
  config["proxy-groups"] = [
    {
      ...groupBaseOption,
      "name": "前置代理",
      "type": "select",
      "proxies": [
        ...countryGroups,
        "自动选择",
        ...otherProxies
      ],
      "icon": "https://img.icons8.com/?size=160&id=0wmdU4RVIEp7&format=png"
    },
    {
      ...groupBaseOption,
      "name": "落地代理",
      "type": "select",
      "proxies": [
        // 使用第一个链式代理节点作为默认选项，而不是"落地优选"
        ...(chainProxyNames.length > 0 ? [chainProxyNames[0]] : []),
        "落地优选",
        ...(chainProxyNames.length > 1 ? chainProxyNames.slice(1) : [])
      ],
      "icon": "https://img.icons8.com/?size=160&id=76XpK7qojvu8&format=png"
    },
    {
      ...groupBaseOption,
      "name": "落地优选",
      "type": "url-test",
      "interval": 600, // 从300改为600，减少测试频率
      "tolerance": 30, // 从50改为30，提高精度
      "lazy": false,
      "proxies": chainProxyNames.length > 0 ? chainProxyNames : allProxies, // 确保使用所有链式代理，如果没有链式代理则使用所有节点
      "url": "https://www.gstatic.com/generate_204", // 使用更快的URL
      "icon": "https://img.icons8.com/?size=100&id=cQ0ncpG1E67g&format=png"
    },
