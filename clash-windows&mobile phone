// 程序入口
function main(config) {
  const proxyCount = config?.proxies?.length ?? 0;
  const proxyProviderCount =
    typeof config?.["proxy-providers"] === "object" ? Object.keys(config["proxy-providers"]).length : 0;
  if (proxyCount === 0 && proxyProviderCount === 0) {
    throw new Error("配置文件中未找到任何代理");
  }

  // 覆盖原配置中DNS配置
  config["dns"] = dnsConfig;

  // --- 核心优化与配置新增/调整 (性能与资源节省) ---
  config["connection-pool"] = {
    "enable": true,
    "max-host-connections": 8, // 优化：限制单主机连接数
    "max-connections": 512, // 优化：限制总连接数
    "min-idle-connections": 4,
    "max-idle-connections": 16,
    "idle-timeout": 60 // 优化：减少空闲连接超时时间
  };

  // TCP/延迟优化
  config["tcp-concurrent"] = true;
  config["unified-delay"] = true; // 新增：启用统一测速延迟，提高准确性
  config["global-client-fingerprint"] = "chrome"; // 新增：统一TLS指纹，增强伪装性

  // 持久化和地理数据优化 (移动端/低配设备)
  config["persistence"] = true; // 新增：启用持久化
  config["store-selected"] = true; // 新增：保存用户选择的节点
  config["profile-store-selected"] = true;
  config["store-fake-ip"] = true;
  config["geodata-mode"] = true; // 新增：启用Geodata内存模式
  config["geodata-loader"] = "memconservative"; // 新增：保守内存加载模式

  config["experimental"] = {
    "ignore-resolve-fail": true,
    "sniff-tls-sni": true,
    "tcp-fast-open": true,
    "tcp-multiplexing": {
      "enable": true,
      "max-connections": 4,
      "min-connections": 1,
      "idle-timeout": 60,
      "enable-conn-reuse": true
    }
  };
  // ---------------------------------------------------


  // 获取所有节点名称
  const allProxies = config?.proxies?.map(p => p.name) || [];

  // 节点类型筛选：只保留 SS, SOCKS5, HTTP 用于链式代理 (根据用户要求修改)
  const allowedTypes = ["ss", "socks5", "http"];
  const chainableProxies = config?.proxies
    ?.filter(p => allowedTypes.includes(p.type.toLowerCase()))
    ?.map(p => p.name) || [];

  // 创建链式代理组 - 为每个可用节点创建一个链式代理组
  const chainProxyGroups = [];
  chainableProxies.forEach(proxy => {
    const chainGroupName = `落地-${proxy}`;
    chainProxyGroups.push({
      ...groupBaseOption,
      "name": chainGroupName,
      "type": "relay", // 使用relay类型实现链式代理
      "proxies": ["前置代理", proxy], // 前置代理 -> 节点
      "icon": "https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Proxy.png",
      "hidden": true // 隐藏这些单独的链式代理组
    });
  });

  // 获取所有链式代理组名称
  const chainProxyNames = chainableProxies.map(proxy => `落地-${proxy}`);

  // 获取所有国家分组名称
  const countryGroups = [
    "日本手动", "美国手动", "台湾手动", "香港手动", "狮城手动", "韩国手动"
  ];

  // 覆盖原配置中的代理组 - 按使用频率和规则优先级调整顺序
  config["proxy-groups"] = [
    {
      ...groupBaseOption,
      "name": "前置代理",
      "type": "select",
      "proxies": [
        ...countryGroups,
        "自动选择",
        ...allProxies // 这里的 "allProxies" 包含了所有类型节点，作为备选
      ],
      "icon": "https://img.icons8.com/?size=160&id=0wmdU4RVIEp7&format=png"
    },
    {
      ...groupBaseOption,
      "name": "落地代理",
      "type": "select",
      "proxies": [
        // 确保至少有一个链式代理组，否则使用所有节点作为备选
        ...(chainProxyNames.length > 0 ? [chainProxyNames[0]] : ["自动选择"]),
        "落地优选",
        ...(chainProxyNames.length > 1 ? chainProxyNames.slice(1) : [])
      ],
      "icon": "https://img.icons8.com/?size=160&id=76XpK7qojvu8&format=png"
    },
    {
      ...groupBaseOption,
      "name": "落地优选",
      "type": "url-test",
      "interval": 600,
      "tolerance": 30, // 优化：提高精度
      "lazy": false,
      "proxies": chainProxyNames.length > 0 ? chainProxyNames : allProxies, // 如果没有符合条件的落地节点，则降级为所有节点
      "url": "https://www.gstatic.com/generate_204",
      "icon": "https://img.icons8.com/?size=100&id=cQ0ncpG1E67g&format=png"
    },
    {
      ...groupBaseOption,
      "name": "节点选择",
      "type": "select",
      "proxies": [
        "落地代理",
        "落地优选",
        ...countryGroups,
        "自动选择",
        ...allProxies
      ],
      "icon": "https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Global.png"
    },
    {
      ...groupBaseOption,
      "name": "自动选择",
      "type": "url-test",
      "interval": 600,
      "tolerance": 30, // 优化：提高精度
      "lazy": false,
      "proxies": allProxies,
      "url": "https://www.gstatic.com/generate_204",
      "icon": "https://fastly.jsdelivr.net/gh/clash-verge-rev/clash-verge-rev.github.io@main/docs/assets/icons/speed.svg"
    },
    // 按使用频率和规则优先级调整后的服务代理组顺序
    {
      ...groupBaseOption,
