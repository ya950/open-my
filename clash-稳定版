    },
    {
      ...groupBaseOption,
      "name": "落地选优",
      "type": "url-test",
      "interval": 300,
      "tolerance": 50,
      "proxies": chainProxyNames.length > 0 ? chainProxyNames : allProxies,
      "icon": "https://cdn.jsdelivr.net/gh/hfg-gmuend/openmoji@13.1.0/color/svg/26A1.svg"
